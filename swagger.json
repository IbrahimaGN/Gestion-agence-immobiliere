{
  "openapi": "3.0.0",
  "info": {
    "title": "TECH 221 - API Gestion Immobilière",
    "version": "1.0.0",
    "description": "API REST pour la gestion des agences, clients, biens et visites immobilières",
    "contact": {
      "name": "TECH 221",
      "email": "contact@tech221.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Serveur de développement"
    },
    {
      "url": "https://tech221-immo-api.onrender.com/api-docs/#/",
      "description": "Serveur de production"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Authentification et gestion des utilisateurs"
    },
    {
      "name": "Agences",
      "description": "Gestion des agences immobilières"
    },
    {
      "name": "Clients",
      "description": "Gestion des clients"
    },
    {
      "name": "Biens",
      "description": "Gestion des biens immobiliers"
    },
    {
      "name": "Visites",
      "description": "Gestion des visites"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Entrez votre token JWT : Bearer <token>"
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Identifiant unique de la ressource",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "example": 1
        }
      }
    },
    "schemas": {
      "RegisterReq": {
        "type": "object",
        "required": ["prenom", "nom", "email", "password"],
        "properties": {
          "prenom": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "example": "Ada",
            "description": "Prénom de l'utilisateur"
          },
          "nom": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "example": "Lovelace",
            "description": "Nom de l'utilisateur"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "ada@example.com",
            "description": "Email unique de l'utilisateur"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 6,
            "example": "secret123",
            "description": "Mot de passe (minimum 6 caractères)"
          },
          "telephone": {
            "type": "string",
            "pattern": "^\\+221(77|78|76)[0-9]{7}$",
            "example": "+221771234567",
            "description": "Numéro de téléphone au format sénégalais"
          },
          "image": {
            "type": "string",
            "format": "uri",
            "example": "https://res.cloudinary.com/tech221/image/upload/ada.jpg",
            "description": "URL de la photo de profil"
          },
          "role": {
            "type": "string",
            "enum": ["CLIENT", "AGENT", "ADMIN"],
            "default": "CLIENT",
            "example": "CLIENT",
            "description": "Rôle de l'utilisateur"
          }
        }
      },
      "LoginReq": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "ada@example.com",
            "description": "Email de l'utilisateur"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "secret123",
            "description": "Mot de passe"
          }
        }
      },
      "TokenRes": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
            "description": "Token JWT d'authentification"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "prenom": {
            "type": "string",
            "example": "Ada"
          },
          "nom": {
            "type": "string",
            "example": "Lovelace"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "ada@example.com"
          },
          "telephone": {
            "type": "string",
            "example": "+221771234567"
          },
          "image": {
            "type": "string",
            "example": "https://res.cloudinary.com/tech221/image/upload/ada.jpg"
          },
          "role": {
            "type": "string",
            "enum": ["CLIENT", "AGENT", "ADMIN"],
            "example": "CLIENT"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-02T10:00:00Z"
          }
        }
      },
      "Agence": {
        "type": "object",
        "required": ["code", "nom", "adresse"],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z]{3}-[0-9]{2}$",
            "example": "DKR-01",
            "description": "Code unique de l'agence"
          },
          "nom": {
            "type": "string",
            "maxLength": 200,
            "example": "Agence Dakar Plateau",
            "description": "Nom de l'agence"
          },
          "adresse": {
            "type": "string",
            "example": "Avenue L.S. Senghor, Dakar",
            "description": "Adresse complète"
          },
          "sousAgence": {
            "type": "string",
            "example": "Dakar Médina",
            "description": "Nom de la sous-agence (optionnel)"
          }
        }
      },
      "UpdateAgence": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "nom": {
            "type": "string",
            "example": "Agence Dakar Plateau"
          },
          "adresse": {
            "type": "string",
            "example": "Avenue L.S. Senghor, Dakar"
          },
          "sousAgence": {
            "type": "string",
            "example": "Dakar Médina"
          }
        }
      },
      "Client": {
        "type": "object",
        "required": ["prenom", "nom", "email", "telephone", "agenceId"],
        "properties": {
          "prenom": {
            "type": "string",
            "example": "Moussa"
          },
          "nom": {
            "type": "string",
            "example": "Diallo"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "moussa@email.com"
          },
          "telephone": {
            "type": "string",
            "pattern": "^\\+221(77|78|76)[0-9]{7}$",
            "example": "+221771234567"
          },
          "agenceId": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          },
          "imageUrl": {
            "type": "string",
            "format": "binary",
            "example": "https://example.com/moussa.jpg"
          }
        }
      },
      "UpdateClient": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "prenom": {
            "type": "string",
            "example": "Moussa"
          },
          "nom": {
            "type": "string",
            "example": "Diallo"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "moussa@email.com"
          },
          "telephone": {
            "type": "string",
            "pattern": "^\\+221(77|78|76)[0-9]{7}$",
            "example": "+221771234567"
          },
          "agenceId": {
            "type": "integer",
            "example": 1
          },
          "imageUrl": {
            "type": "string",
            "format": "binary",
            "example": "https://example.com/moussa.jpg"
          }
        }
      },
      "Bien": {
        "type": "object",
        "required": ["titre", "type", "adresse", "prix", "agenceId"],
        "properties": {
          "titre": {
            "type": "string",
            "maxLength": 200,
            "example": "Appartement F3 aux Almadies"
          },
          "type": {
            "type": "string",
            "enum": ["MAISON", "APPARTEMENT", "STUDIO", "TERRAIN", "VILLA", "BUREAU", "COMMERCE"],
            "example": "APPARTEMENT"
          },
          "adresse": {
            "type": "string",
            "example": "Almadies, Dakar"
          },
          "prix": {
            "type": "number",
            "minimum": 0,
            "example": 250000
          },
          "statut": {
            "type": "string",
            "enum": ["DISPONIBLE", "RESERVE", "LOUE", "VENDU", "ARCHIVE"],
            "default": "DISPONIBLE",
            "example": "DISPONIBLE"
          },
          "agenceId": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          }
        }
      },
      "UpdateBien": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "titre": {
            "type": "string",
            "example": "Appartement F3 aux Almadies"
          },
          "type": {
            "type": "string",
            "enum": ["MAISON", "APPARTEMENT", "STUDIO", "TERRAIN", "VILLA", "BUREAU", "COMMERCE"]
          },
          "adresse": {
            "type": "string",
            "example": "Almadies, Dakar"
          },
          "prix": {
            "type": "number",
            "example": 250000
          },
          "statut": {
            "type": "string",
            "enum": ["DISPONIBLE", "RESERVE", "LOUE", "VENDU", "ARCHIVE"]
          },
          "agenceId": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "Visite": {
        "type": "object",
        "required": ["clientId", "bienId", "dateVisite"],
        "properties": {
          "clientId": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          },
          "bienId": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          },
          "dateVisite": {
            "type": "string",
            "format": "date-time",
            "example": "2026-12-25T10:00:00Z"
          },
          "commentaire": {
            "type": "string",
            "maxLength": 500,
            "example": "Intéressé par un bail de 2 ans"
          }
        }
      },
      "UpdateStatutVisite": {
        "type": "object",
        "required": ["statut"],
        "properties": {
          "statut": {
            "type": "string",
            "enum": ["DEMANDEE", "CONFIRMEE", "ANNULEE", "EFFECTUEE"],
            "example": "CONFIRMEE"
          },
          "commentaire": {
            "type": "string",
            "maxLength": 500,
            "example": "Visite confirmée par téléphone"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Erreur de validation"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Inscription d'un nouvel utilisateur",
        "description": "Crée un nouveau compte utilisateur",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterReq"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Utilisateur créé avec succès",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Utilisateur créé avec succès"
                    },
                    "data": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Données invalides",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Email déjà utilisé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Connexion utilisateur",
        "description": "Authentifie un utilisateur et retourne un token JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginReq"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Connexion réussie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenRes"
                }
              }
            }
          },
          "401": {
            "description": "Identifiants invalides",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/agences": {
      "get": {
        "tags": ["Agences"],
        "summary": "Lister toutes les agences",
        "description": "Retourne la liste de toutes les agences",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Succès",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Agence"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Non authentifié"
          }
        }
      },
      "post": {
        "tags": ["Agences"],
        "summary": "Créer une agence",
        "description": "Crée une nouvelle agence (Admin uniquement)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Agence"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Agence créée avec succès",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Agence créée avec succès"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Agence"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Données invalides"
          },
          "401": {
            "description": "Non authentifié"
          },
          "403": {
            "description": "Accès non autorisé"
          },
          "409": {
            "description": "Code déjà existant"
          }
        }
      }
    },
    "/api/agences/{id}": {
      "get": {
        "tags": ["Agences"],
        "summary": "Obtenir une agence par son ID",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "description": "Succès",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/Agence"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Agence non trouvée"
          }
        }
      },
      "put": {
        "tags": ["Agences"],
        "summary": "Modifier une agence",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAgence"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Agence mise à jour avec succès"
          },
          "404": {
            "description": "Agence non trouvée"
          }
        }
      },
      "delete": {
        "tags": ["Agences"],
        "summary": "Supprimer une agence",
        "description": "Supprime une agence (refusé si des clients ou biens sont liés)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "description": "Agence supprimée avec succès"
          },
          "409": {
            "description": "Relations existantes - Impossible de supprimer"
          }
        }
      }
    },
    "/api/clients": {
      "get": {
        "tags": ["Clients"],
        "summary": "Lister les clients",
        "description": "Retourne la liste des clients avec filtres optionnels",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "agenceId",
            "schema": {
              "type": "integer"
            },
            "description": "Filtrer par ID d'agence"
          },
          {
            "in": "query",
            "name": "recherche",
            "schema": {
              "type": "string"
            },
            "description": "Rechercher par nom, prénom, email ou téléphone"
          }
        ],
        "responses": {
          "200": {
            "description": "Succès"
          }
        }
      },
      "post": {
        "tags": ["Clients"],
        "summary": "Enregistrer un client",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Client"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Client créé avec succès"
          },
          "409": {
            "description": "Email ou téléphone déjà utilisé"
          }
        }
      }
    },
    "/api/clients/{id}": {
      "get": {
        "tags": ["Clients"],
        "summary": "Obtenir un client par son ID",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "description": "Succès"
          },
          "404": {
            "description": "Client non trouvé"
          }
        }
      },
      "put": {
        "tags": ["Clients"],
        "summary": "Modifier un client",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/UpdateClient"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Client mis à jour avec succès"
          },
          "404": {
            "description": "Client non trouvé"
          },
          "409": {
            "description": "Email déjà utilisé"
          }
        }
      },
      "delete": {
        "tags": ["Clients"],
        "summary": "Supprimer un client",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "description": "Client supprimé avec succès"
          },
          "409": {
            "description": "A des visites liées - Impossible de supprimer"
          }
        }
      }
    },
    "/api/biens/catalogue": {
      "get": {
        "tags": ["Biens"],
        "summary": "Catalogue public des biens",
        "description": "Retourne la liste des biens disponibles (exclut les biens archivés)",
        "parameters": [
          {
            "in": "query",
            "name": "type",
            "schema": {
              "type": "string",
              "enum": ["MAISON", "APPARTEMENT", "STUDIO", "TERRAIN", "VILLA", "BUREAU", "COMMERCE"]
            },
            "description": "Filtrer par type de bien"
          },
          {
            "in": "query",
            "name": "statut",
            "schema": {
              "type": "string"
            },
            "description": "Filtrer par statut"
          },
          {
            "in": "query",
            "name": "prixMin",
            "schema": {
              "type": "number"
            },
            "description": "Prix minimum"
          },
          {
            "in": "query",
            "name": "prixMax",
            "schema": {
              "type": "number"
            },
            "description": "Prix maximum"
          }
        ],
        "responses": {
          "200": {
            "description": "Succès"
          }
        }
      }
    },
    "/api/biens": {
      "get": {
        "tags": ["Biens"],
        "summary": "Lister tous les biens (Admin)",
        "description": "Retourne tous les biens avec filtres (Admin uniquement)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "type",
            "schema": {
              "type": "string",
              "enum": ["MAISON", "APPARTEMENT", "STUDIO", "TERRAIN", "VILLA", "BUREAU", "COMMERCE"]
            }
          },
          {
            "in": "query",
            "name": "statut",
            "schema": {
              "type": "string",
              "enum": ["DISPONIBLE", "RESERVE", "LOUE", "VENDU", "ARCHIVE"]
            }
          },
          {
            "in": "query",
            "name": "agenceId",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "prixMin",
            "schema": {
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "prixMax",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Succès"
          }
        }
      },
      "post": {
        "tags": ["Biens"],
        "summary": "Enregistrer un bien",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Bien"
              }
            }
          }
